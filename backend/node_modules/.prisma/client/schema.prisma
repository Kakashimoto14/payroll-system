// ============================================================================
// PRISMA SCHEMA — McDonald's Montalban Payroll System
// Database: PostgreSQL
// ORM: Prisma Client
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  CREW_MEMBER
  SHIFT_MANAGER
  HR_ADMIN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

enum PayrollStatus {
  DRAFT
  COMPUTED
  APPROVED
  DISBURSED
}

enum LeaveType {
  VACATION
  SICK
  EMERGENCY
  MATERNITY
  PATERNITY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HolidayType {
  REGULAR
  SPECIAL_NON_WORKING
  SPECIAL_WORKING
}

enum DisbursementMethod {
  BANK_TRANSFER
  GCASH
  MAYA
  CASH
}

enum DisbursementStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum NotificationType {
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ============================================================================
// MODELS
// ============================================================================

/// Branch locations for geofence validation
model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String
  latitude  Float
  longitude Float
  radius    Int      @default(500) // meters
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees  Employee[]
  attendance Attendance[]

  @@map("branches")
}

/// Core employee record — maps to OOP class hierarchy in application layer
model Employee {
  id             String         @id @default(uuid())
  employeeId     String         @unique // MCD-XXXXXX
  firstName      String
  lastName       String
  email          String         @unique
  phone          String
  passwordHash   String
  role           Role           @default(CREW_MEMBER)
  employmentType EmploymentType @default(FULL_TIME)

  // Compensation — ENCAPSULATION: exposed only via DTOs
  dailyRate     Float  @default(550.00)
  hourlyRate    Float  @default(68.75)
  monthlySalary Float? // For salaried employees (managers/admins)

  // Government IDs — ENCAPSULATION: private, never exposed in list endpoints
  sssNumber        String?
  philhealthNumber String?
  pagibigNumber    String?
  tinNumber        String?

  // Banking
  bankAccountNumber String?
  bankName          String?

  // Employment details
  dateHired   DateTime
  dateOfBirth DateTime?
  address     String?
  status      EmployeeStatus @default(ACTIVE)

  // Branch assignment
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  attendance        Attendance[]
  payrolls          Payroll[]
  payslips          Payslip[]
  leaveRequests     LeaveRequest[] @relation("EmployeeLeaves")
  approvedLeaves    LeaveRequest[] @relation("LeaveApprover")
  disbursements     Disbursement[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  processedPayrolls Payroll[]      @relation("PayrollProcessor")

  @@index([role])
  @@index([status])
  @@index([branchId])
  @@map("employees")
}

/// Daily attendance records with geolocation verification
model Attendance {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  clockIn        DateTime
  clockOut       DateTime?
  hoursWorked    Float? // Calculated dynamically — NOT hardcoded 8 hours
  overtimeHours  Float     @default(0)
  nightDiffHours Float     @default(0)

  // Geolocation data
  clockInLatitude   Float?
  clockInLongitude  Float?
  clockOutLatitude  Float?
  clockOutLongitude Float?
  isGeoverified     Boolean @default(false)

  // Branch validation
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  status    AttendanceStatus @default(PRESENT)
  remarks   String?
  createdAt DateTime         @default(now())

  @@index([employeeId])
  @@index([clockIn])
  @@index([employeeId, clockIn])
  @@map("attendance")
}

/// Payroll computation per employee per pay period
model Payroll {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  payrollPeriod String // "2026-04-01 to 2026-04-15"
  periodStart   DateTime
  periodEnd     DateTime
  payDate       DateTime?

  // Earnings — computed dynamically from actual hours
  totalHoursWorked Float @default(0)
  basicPay         Float @default(0)
  overtimePay      Float @default(0)
  nightDiffPay     Float @default(0)
  holidayPay       Float @default(0)
  grossPay         Float @default(0)

  // Deductions — Philippine mandatory contributions
  sssDeduction        Float @default(0)
  philhealthDeduction Float @default(0)
  pagibigDeduction    Float @default(0)
  withholdingTax      Float @default(0)
  otherDeductions     Float @default(0)
  totalDeductions     Float @default(0)

  netPay Float @default(0)

  status        PayrollStatus @default(DRAFT)
  processedAt   DateTime?
  processedById String?
  processedBy   Employee?     @relation("PayrollProcessor", fields: [processedById], references: [id])

  createdAt DateTime @default(now())

  // Relations
  payslip      Payslip?
  disbursement Disbursement?

  @@index([employeeId])
  @@index([periodStart, periodEnd])
  @@index([status])
  @@map("payrolls")
}

/// Digital payslip with PDF generation and delivery tracking
model Payslip {
  id         String   @id @default(uuid())
  payrollId  String   @unique
  payroll    Payroll  @relation(fields: [payrollId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  payslipNumber String    @unique // PS-YYYYMMDD-XXXX
  pdfUrl        String?
  pdfPassword   String? // Encrypted password for PDF
  isEmailSent   Boolean   @default(false)
  isSmsSent     Boolean   @default(false)
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([employeeId])
  @@map("payslips")
}

/// Leave management
model LeaveRequest {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation("EmployeeLeaves", fields: [employeeId], references: [id])

  leaveType LeaveType
  startDate DateTime
  endDate   DateTime
  totalDays Int
  reason    String?

  status       LeaveStatus @default(PENDING)
  approvedById String?
  approvedBy   Employee?   @relation("LeaveApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

/// Philippine holidays for holiday pay computation
model Holiday {
  id           String      @id @default(uuid())
  name         String
  date         DateTime
  type         HolidayType
  isNationwide Boolean     @default(true)
  createdAt    DateTime    @default(now())

  @@index([date])
  @@map("holidays")
}

/// Payment disbursement records
model Disbursement {
  id         String   @id @default(uuid())
  payrollId  String   @unique
  payroll    Payroll  @relation(fields: [payrollId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  amount          Float
  referenceNumber String?
  method          DisbursementMethod @default(BANK_TRANSFER)
  status          DisbursementStatus @default(PENDING)
  bankName        String?
  accountNumber   String?

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([employeeId])
  @@index([status])
  @@map("disbursements")
}

/// Notification tracking for SMS and Email
model Notification {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  type      NotificationType
  subject   String?
  message   String
  status    NotificationStatus @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([employeeId])
  @@index([status])
  @@map("notifications")
}

/// Audit log for all system actions
model AuditLog {
  id     String    @id @default(uuid())
  userId String?
  user   Employee? @relation(fields: [userId], references: [id])

  action    String // CREATE, UPDATE, DELETE, LOGIN, CLOCK_IN, etc.
  entity    String // Employee, Payroll, Attendance, etc.
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
